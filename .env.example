# docker-compose 실행 시 이 파일을 .env로 복사 후 실제 값 입력
# cp .env.example .env

# DB 비밀번호 (MySQL root 패스워드)
DB_PASSWORD=your_mysql_password

# 업비트 API 키 (upbit.com → 개인정보 → Open API 관리)
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# JWT 시크릿 (임의의 긴 문자열)
JWT_SECRET=your_jwt_secret_base64

# 뉴스·공시 API (기능3)
DART_API_KEY=your_dart_api_key          # opendart.fss.or.kr 인증키
BIGKINDS_API_KEY=your_bigkinds_api_key  # bigkinds.or.kr API 키
NAVER_CLIENT_ID=your_naver_client_id    # developers.naver.com Client ID
NAVER_CLIENT_SECRET=your_naver_secret   # developers.naver.com Client Secret

# AI 기업 리포트 (기능4)
GEMINI_API_KEY=your_gemini_api_key      # aistudio.google.com/app/apikey
